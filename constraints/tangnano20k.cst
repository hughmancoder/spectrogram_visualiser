// Physical Constraints for Sipeed Tang Nano 20K
// FPGA: Gowin GW2AR-LV18QN88C8/I7 (LittleBee / Arora GW2A-18 family)

// ==============================================================================
// 1. Clock (27 MHz onboard crystal)
// ==============================================================================
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ==============================================================================
// 2. User Buttons (Active Low - pressed = 0, released = 1)
// ==============================================================================
IO_LOC "btn[0]" 88; // S1 / Key 1
IO_PORT "btn[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "btn[1]" 87; // S2 / Key 2
IO_PORT "btn[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ==============================================================================
// 3. User LEDs (Active Low - 0 = ON / lit, 1 = OFF)
// ==============================================================================
IO_LOC "led[0]" 15;
IO_PORT "led[0]" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "led[1]" 16;
IO_PORT "led[1]" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "led[2]" 17;
IO_PORT "led[2]" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "led[3]" 18;
IO_PORT "led[3]" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "led[4]" 19;
IO_PORT "led[4]" DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "led[5]" 20;
IO_PORT "led[5]" DRIVE=8 IO_TYPE=LVCMOS33;

// ==============================================================================
// 4. HDMI / DVI TX
// ==============================================================================
IO_LOC "tmds_data_p[0]" 35;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_data_n[0]" 36;
IO_PORT "tmds_data_n[0]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;

IO_LOC "tmds_data_p[1]" 37;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_data_n[1]" 38;
IO_PORT "tmds_data_n[1]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;

IO_LOC "tmds_data_p[2]" 39;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_data_n[2]" 40;
IO_PORT "tmds_data_n[2]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;

IO_LOC "tmds_clk_p" 33;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_clk_n" 34;
IO_PORT "tmds_clk_n" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
